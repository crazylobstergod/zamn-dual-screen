<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (API 26+; minSdk is 26 so this applies on every supported
  device). The launcher composites these two layers and applies ITS OWN
  shape mask — this is what removes the white-plate / black-square
  legacy-icon treatment some launcher3 builds apply.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg" />
    <foreground android:drawable="@drawable/ic_launcher_fg" />
</adaptive-icon>
